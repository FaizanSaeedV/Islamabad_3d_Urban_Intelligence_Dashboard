# ------------------------------------------------------------------
# Smart City Digital Twin - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# --- PostgreSQL / PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_city_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# --- External APIs (all free, no key required) ---
# Open-Meteo requires NO API key: https://open-meteo.com/
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Public OSRM demo server (routing). For production host your own.
OSRM_BASE_URL=https://router.project-osrm.org

# --- Frontend (set in frontend/js/config.js, listed here for reference) ---
# Cesium ion token is OPTIONAL. Without it the app uses OpenStreetMap
# imagery + ellipsoid terrain (no key needed). To enable Cesium World
# Terrain, create a FREE account at https://ion.cesium.com/ and copy
# your default access token.
CESIUM_ION_TOKEN=
